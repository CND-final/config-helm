# prometheus-postgres-exporter values (example)
#
# Usage:
#   1. Copy to the real file: cp pg-exporter-values.yaml.example pg-exporter-values.yaml
#   2. Retrieve the Zalando-generated postgres superuser password (decode base64 in PowerShell):
#        $b64 = kubectl get secret postgres.config-man-postgres.credentials.postgresql.acid.zalan.do `
#                 -n config-man -o jsonpath="{.data.password}"
#        [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b64))
#   3. Paste the decoded plaintext into `password` below
#   4. Install:
#        helm install pg-exporter prometheus-community/prometheus-postgres-exporter \
#          -n monitoring -f pg-exporter-values.yaml
#
# Note: pg-exporter-values.yaml (with the real password) is excluded by .gitignore and never committed.

config:
  datasource:
    host: "config-man-postgres.config-man.svc.cluster.local"  # master service
    user: "postgres"                # superuser; fullest access to monitoring views
    password: "<YOUR_DB_PASSWORD>"  # <- paste the plaintext password decoded from the Zalando secret
    port: "5432"
    database: "config_man"
    sslmode: "require"              # Zalando enforces SSL; do not omit

serviceMonitor:
  enabled: true
  labels:
    release: monitoring             # match the kube-prometheus-stack release name so Prometheus scrapes it

resources:
  requests:
    cpu: 25m
    memory: 32Mi
