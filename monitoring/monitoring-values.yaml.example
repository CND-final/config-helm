# kube-prometheus-stack values (example) — trimmed for single-node Docker Desktop K8s
#
# Usage:
#   1. Copy to the real file: cp monitoring-values.yaml.example monitoring-values.yaml
#   2. Change the Grafana password as needed (a simple value is fine for a demo)
#   3. Install:
#        helm install monitoring prometheus-community/kube-prometheus-stack \
#          -n monitoring --create-namespace -f monitoring-values.yaml
#
# Note: monitoring-values.yaml (with the Grafana password) is excluded by .gitignore and never committed.

# Alertmanager: not needed for the demo; disabled to save memory
alertmanager:
  enabled: false

# node-exporter: on Docker Desktop on Windows, mounting host paths causes CrashLoopBackOff; disabled
# (single-node + VM environment, so node-level hardware metrics have no reference value anyway)
nodeExporter:
  enabled: false

prometheus:
  prometheusSpec:
    retention: 2d           # keep data for 2 days; enough for a demo
    scrapeInterval: "5s"    # scrape every 5s so the brief gap during failover / pod kill is captured
    evaluationInterval: "5s"
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        memory: 1Gi

grafana:
  adminPassword: "<YOUR_GRAFANA_PASSWORD>"  # <- a simple value like admin is fine for a demo
  resources:
    requests:
      cpu: 50m
      memory: 128Mi

prometheusOperator:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
