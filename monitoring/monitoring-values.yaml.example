# kube-prometheus-stack values（範例）— 針對 Docker Desktop 單機 K8s 精簡
#
# 使用方式：
#   1. 複製成本檔： cp monitoring-values.yaml.example monitoring-values.yaml
#   2. 視需要修改 Grafana 密碼（demo 用可維持簡單值）
#   3. 安裝：
#        helm install monitoring prometheus-community/kube-prometheus-stack \
#          -n monitoring --create-namespace -f monitoring-values.yaml
#
# 注意：monitoring-values.yaml（含 Grafana 密碼）已被 .gitignore 排除，不進版控。

# Alertmanager：demo 不需要告警，關掉省記憶體
alertmanager:
  enabled: false

# node-exporter：Docker Desktop on Windows 掛載宿主機路徑會 CrashLoopBackOff，關閉
# （單節點 + VM 環境，節點層級硬體指標本就無參考價值）
nodeExporter:
  enabled: false

prometheus:
  prometheusSpec:
    retention: 2d           # 資料保留 2 天，demo 夠用
    scrapeInterval: "5s"    # 抓取頻率 5s，讓 failover/殺 pod 的瞬間缺口抓得到
    evaluationInterval: "5s"
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        memory: 1Gi

grafana:
  adminPassword: "<YOUR_GRAFANA_PASSWORD>"  # ← demo 用可填簡單值，如 admin
  resources:
    requests:
      cpu: 50m
      memory: 128Mi

prometheusOperator:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
